<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/settingsUserGuideButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="User Guide"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:backgroundTint="#2A2A2A" />

        <Button
            android:id="@+id/settingsGoalsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Goals"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:backgroundTint="#2A2A2A" />

        <Button
            android:id="@+id/settingsAboutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the Developer"
            android:textColor="#FFFFFF"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:backgroundTint="#2A2A2A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BEEP EVERY # REPS"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set 0 to turn beeps off for that exercise."
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Squats"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/settingsSquatBeepInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 5"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jump Rope"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/settingsJumpBeepInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:hint="e.g. 20"
            android:textColorHint="#666666"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/settingsSaveBeepButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

    </LinearLayout>

</ScrollView>
